{
  "description": "Swap external displays via Hammerspoon (Right Cmd + \\)",
  "manipulators": [
    {
      "type": "basic",
      "from": {
        "key_code": "backslash",
        "modifiers": { "mandatory": ["right_command"] }
      },
      "to": [
        {
          "shell_command": "open -g 'hammerspoon://swapDisplays'"
        }
      ]
    }
  ]
}
